.workbuddy-*.log

# ============================================================
# ★ 测试 / 验收 / 探针 / 诊断脚本（不随仓库发布）
#   scripts/ 只保留构建与运维工具：
#     build_gui.py / build_installer.py / deploy-gui.py / deploy_cloud*.py /
#     deploy_python.py / toolchain.py / sshtarget.py / switch-db.py /
#     start-agent.py / status-agent.py / run-scheduled.py / rthook_reap_mei.py /
#     pull-*.py / rmf*.py / livecreds.py / backfill-unit-pack.py
# ============================================================
scripts/verify-*
scripts/probe-*
scripts/probe_server*.py
scripts/check-*
scripts/check_remote*.py
scripts/test-*
scripts/diag-*
scripts/accept-*
scripts/compare-*
scripts/bisect-*
scripts/ab-*
scripts/why-*
scripts/who-*
scripts/find-*
scripts/profile-*
scripts/finalize-*
scripts/clean-*
scripts/cleanup-*
scripts/kill-*
scripts/ws_probe_*
scripts/dump-exe-*
scripts/run-r9-*
scripts/stub-*
