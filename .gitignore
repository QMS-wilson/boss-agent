scripts/__pycache__/

# tests/ 整体不发布（本地自测脚本）
tests/

# ============================================================
# print_formats：只留格式模板（.bin/.txt/.json），
# 渲染预览图（.png/.html）与从库拉取的副本（_pulled*）不发布
# ============================================================
print_formats/**/*.png
print_formats/**/*.html
print_formats/_pulled*/
